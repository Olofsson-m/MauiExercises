<?xml version="1.0" encoding="UTF-8"?>
<ContentPage    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                x:Class="MauiExercises.Views.Lesson03.GridLayoutExercise" Title="Grid Exercise">
	<ContentPage.Content>
        
        <!-- Change here so the contact sheet is fixed in size and centered on the page-->
        <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
            <Grid WidthRequest="400" HeightRequest="350">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
 
                <!-- Position below elements in the Grid using Grid.Row, Grid.Column, Grid.RowSpan, GridColumnSpan -->
                <StackLayout BackgroundColor="Green" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="3">
                    <Image Source="monkey.jfif" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" 
                           Aspect="AspectFill"/>
                </StackLayout>
                <StackLayout BackgroundColor="LightBlue" Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="3">
                    <Label Text="Contact Details" TextColor="Black" FontSize="30" HorizontalOptions="Center" />
                </StackLayout>
                <StackLayout BackgroundColor="Salmon" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3">
                    <Label Text="Phone:" TextColor="Black" />
                </StackLayout>
                <StackLayout BackgroundColor="IndianRed" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3">
                    <Label Text="Email:" TextColor="Black"/>
                </StackLayout>
                <StackLayout BackgroundColor="Purple" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5" Grid.RowSpan="2">
                    <Label Text="Details:" TextColor="Black"/>
                </StackLayout>
                <StackLayout BackgroundColor="Yellow" Grid.Row="6" Grid.ColumnSpan="2">
                    <Label Text="Cancel" TextColor="Black" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand"/>
                </StackLayout>
                <StackLayout BackgroundColor="SaddleBrown" Grid.Row="6" Grid.Column="3" Grid.ColumnSpan="2">
                    <Label Text="Save" TextColor="Black" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand"/>
                </StackLayout>
            </Grid>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>
